@page "/"
@layout DevRoadmap.Components.Layout.Home.HomeLayout

<PageTitle>DevRoadmap</PageTitle>

<section class="background">
    <small class="small small-container">Trilhas Completas para Iniciantes</small>
    <h1 class="title">Trilhas em Desenvolvimento de Software</h1>
    <p class="text">O DevRoadmap organiza seu aprendizado em trilhas, módulos e desafios práticos. Professores acompanham o progresso dos alunos enquanto estudantes sabem exatamente qual é o próximo passo da jornada.</p>
    
    <div class="direction">
        <div class="">
            <i class="ti ti-books icon"/>
            <small class="small">Diversas trilhas disponíveis</small>
        </div>
        <div>
            <i class="ti ti-route icon"/>
            <small class="small">Módulos organizados</small>
        </div>
        <div>
            <i class="ti ti-target-arrow icon"/>
            <small class="small">Do básico ao projeto final</small>
        </div>
    </div>

    <div class="direction">
        <button class="button button-primary">
            Começar agora
            <i class="ti ti-arrow-big-right-lines icon-button"></i>
        </button>
        <button class="button button-secondary">Já tenho uma conta</button>
    </div>
</section>