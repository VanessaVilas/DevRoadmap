@page "/student/dashboard"
@layout DevRoadmap.Components.Layout.Student.StudentLayout

<PageTitle>Dashboard</PageTitle>

<div>
    <div class="ph">
        <div>
            <p class="pt">Olá, Vanessa!</p>
            <p class="ps">Você está a 3 passos do próximo certificado</p>
        </div>

        <button class="button button-gold button-small">+ Nova Trilha</button>
    </div>

    <div class="next-stop">
        <div class="progress-circle">
            <svg width="60" height="60">
                <circle class="background" cx="30" cy="30" r="24"/>
                <circle class="progress" cx="30" cy="30" r="24"/>
            </svg>
        </div>
    </div>
</div>

