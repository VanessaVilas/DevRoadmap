@page "/student/dashboard"
@layout DevRoadmap.Components.Layout.Student.StudentLayout
@using DevRoadmap.Components.Layout.Global

<PageTitle>Dashboard</PageTitle>

<div>
    <div class="page-header">
        <div>
            <p class="page-title">Olá, Vanessa!</p>
            <p class="page-subtitle">Você está a 3 passos do próximo certificado</p>
        </div>

        <button class="button button-gold button-small">+ Nova Trilha</button>
    </div>

    <div class="next-stop">
        <div class="progress-circle">
            <svg width="75" height="75">
                <g class="circle-progress">
                    <circle class="progress-background" cx="30" cy="30" r="24"/>
                    <circle class="progress" cx="30" cy="30" r="24"/>
                </g>
                <text class="progress-text" x="30" y="50">78%</text>
            </svg>
        </div>
        
        <div class="ns-label">
            <i class="ti ti-pinned icon"/>
            Próxima parada
        </div>

        <p class="ns-title">Hooks Avançados</p>

        <p class="ns-subtitle">React & Ecossistema · Módulo 3 de 8</p>

        <div class="ns-steps">
            <div class="ns-step">
                <i class="ti ti-circle-check"/>
                Exercício: Refatorar com useMemo
            </div>
            
            <div class="ns-step">
                <i class="ti ti-circle-check"/>
                Projeto: Context API com useReducer
            </div>
        
            <div class="ns-step no-active">
                <i class="ti ti-lock no-active"/>
                Avaliação do módulo (bloqueada)
            </div>
        </div>

        <button class="button button-gold">
            Continuar agora
            <i class="ti ti-arrow-narrow-right icon-button"/>
        </button>
    </div>

    <div class="g4">
        <DashboardCard
            Title="Progresso Geral"
            Value="68%"
            Status="↑ +4% esta semana"
            CardClass="card-gold"
            ValueClass="cv-g"
            StatusClass="cs-up"
            ShowProgress="true"
            Progress="68" />

        <DashboardCard
            Title="Média Geral"
            Value="8.4"
            Status="acima da mínima"
            ValueClass="cv-gr"
            StatusClass="cs-up" 
            BorderColor="padding:18px;
                border-color:rgba(82,196,138,.25);" />

        <DashboardCard
            Title="Pendências"
            Value="3"
            Status="2 avaliações + 1 projeto"
            ValueClass="cv-o"
            StatusClass="cs-dn"
            BorderColor="rgba(249,115,22,.25)" />

        <DashboardCard
            Title="Certificados"
            Value="2"
            Status="1 em andamento"
            ValueClass="cv-g" />
    </div>
</div>